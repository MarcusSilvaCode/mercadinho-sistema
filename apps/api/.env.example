# Banco de dados
DATABASE_URL="postgresql://mercadinho:mercadinho@localhost:5432/mercadinho?schema=public"

# Autenticação
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="8h"

# Servidor
PORT=3333
NODE_ENV=development

# Rate limit de login
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Sessão / bloqueio de tela
SESSION_TIMEOUT_MINUTES=15

# Backup (nuvem — placeholders, definidos na Fase 15)
BACKUP_STORAGE_BUCKET=""
BACKUP_STORAGE_ACCESS_KEY=""
BACKUP_STORAGE_SECRET_KEY=""
